--!strict
-- Packs our art into the generated data modules the game ships (src/shared/Art/*Data.luau): each image a
-- run-length coverage mask in base64. Run: lune run tools/art/pack.luau
local fs = require("@lune/fs")
local Raster = require("./raster")
local Icons = require("./icons")
local Standards = require("./standards")
local ShopFlags = require("../../src/shared/Assets/ShopFlags")
local M = require("./codec")

local names = {}
for k in Icons do
	if k ~= "ALIASES" then
		table.insert(names, k)
	end
end
table.sort(names)
local SIZE = 128 -- twice the client's atlas cell (UI/ArtAtlas.CELL): sharp when a glyph is drawn large
local lines = {
	"-- GENERATED by tools/art/pack.luau from tools/art/icons.luau: do not edit by hand.",
	"-- Our UI glyphs: 128 x 128 white-on-transparent coverage masks, run-length + base64 (Art/Pack decodes).",
	"return {",
	"\tsize = " .. SIZE .. ",",
	"\ticons = {",
}
local total = 0
for _, name in names do
	local m = Raster.render(Icons[name], SIZE, SIZE, 64)
	local text = M.b64(M.rle(m))
	total += #text
	table.insert(lines, string.format("\t\t%s = \"%s\",", name, text))
end
table.insert(lines, "\t},")
table.insert(lines, "\taliases = {")
local aliases = {}
for k, v in Icons.ALIASES do
	table.insert(aliases, string.format("\t\t%s = \"%s\",", k, v))
end
table.sort(aliases)
for _, l in aliases do
	table.insert(lines, l)
end
table.insert(lines, "\t},")
table.insert(lines, "}")
fs.writeFile("src/shared/Art/IconData.luau", table.concat(lines, "\n") .. "\n")
print(string.format("packed %d icons, %d characters of data", #names, total))

-- The Standards' pictures: their own module, never in the UI's glyph atlas, and drawn larger, since the shop's biggest card
-- shows a charge about 120 px tall. Rarity comes from the Standard's row, so it can't disagree with the price.
local CHARGE = 128
local rarity = {}
for _, f in ShopFlags.flags do
	rarity[f.key] = f.rarity
end
local keys = {}
for k in Standards do
	assert(rarity[k], "a picture with no Standard: " .. k)
	table.insert(keys, k)
end
table.sort(keys)
for k in rarity do
	assert(Standards[k], "a Standard with no picture: " .. k)
end
local function hex(c: number): string
	return string.format("0x%06X", c)
end
local out = {
	"-- GENERATED by tools/art/pack.luau from tools/art/standards.luau: do not edit by hand.",
	"-- The Standards' pictures, by key (Art/Emblem paints them): a field, its colours, and run-length + base64 masks.",
	"return {",
	"\tsize = " .. CHARGE .. ",",
	"\tlooks = {",
}
local bytes = 0
for _, k in keys do
	local s = Standards[k]
	local main = M.b64(M.rle(Raster.render(s.main, CHARGE, CHARGE, 64)))
	local accent = if s.accent then M.b64(M.rle(Raster.render(s.accent, CHARGE, CHARGE, 64))) else nil
	bytes += #main + (if accent then #accent else 0)
	table.insert(
		out,
		string.format(
			'\t\t%s = { rarity = "%s", field = "%s", c = { %s, %s, %s, %s }, main = "%s"%s },',
			k,
			rarity[k],
			s.field,
			hex(s.c[1]),
			hex(s.c[2]),
			hex(s.c[3]),
			hex(s.c[4]),
			main,
			if accent then string.format(', accent = "%s"', accent) else ""
		)
	)
end
table.insert(out, "\t},")
table.insert(out, "}")
fs.writeFile("src/shared/Art/StandardData.luau", table.concat(out, "\n") .. "\n")
print(string.format("packed %d Standards, %d characters of data", #keys, bytes))
