--!nonstrict
-- Map thumbnails, ours: each map's terrain bytes sampled down to fit 192 px, run-length packed into
-- src/shared/Art/Thumbs/<id>.luau (one module per map). The client colours them with the chart palette (MapSurface.terrain_pixel), so a
-- thumbnail is the map as the game draws it. Run: lune run tools/art/thumbs.luau
local fs = require("@lune/fs")
require("../lune_prelude")
local WorldMap = require("../../src/shared/Core/WorldMap")
local MapList = require("../../src/shared/Data/MapList")
local Raster = require("./raster")
local Codec = require("./codec")

local FIT = 160
fs.writeDir("src/shared/Art/Thumbs")
local count = 0
local rows = if MapList.maps then MapList.maps else MapList
for _, m in rows do
	if type(m) == "table" and m.id ~= nil then
		local ok, map = pcall(WorldMap.get, m.id)
		if ok and map ~= nil and map.tile_bytes ~= nil then
			local W, H = map.W, map.H
			local k = math.max(W, H) / FIT
			local tw, th = math.max(1, math.floor(W / k)), math.max(1, math.floor(H / k))
			local mask = Raster.new(tw, th)
			for y = 0, th - 1 do
				for x = 0, tw - 1 do
					local sx, sy = math.min(W - 1, math.floor((x + 0.5) * k)), math.min(H - 1, math.floor((y + 0.5) * k))
					local tb = buffer.readu8(map.tile_bytes, sy * W + sx)
					-- (a thumbnail does not need every magnitude: eight levels, so the runs are long)
					buffer.writeu8(mask.a, y * tw + x, (if bit32.band(tb, 31) == 31 then tb else bit32.band(tb, 0xE0) + bit32.band(tb, 31) // 4 * 4))
				end
			end
			local text = string.format("-- GENERATED by tools/art/thumbs.luau: do not edit by hand. %s: terrain bytes (quantised), run-length + base64.\nreturn { w = %d, h = %d, data = \"%s\" }\n", m.id, tw, th, Codec.b64(Codec.rle(mask)))
			fs.writeFile("src/shared/Art/Thumbs/" .. m.id .. ".luau", text)
			print(m.id, tw, th)
		end
	end
end
print("thumbnails written")
